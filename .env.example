# Chép thành .env.local để chạy web trên máy (npm run dev). Trên Amplify đặt ở App settings → Environment variables.
# Chỉ biến NEXT_PUBLIC_* ở đây, và chúng KHÔNG bí mật (bị đóng vào JavaScript gửi xuống trình duyệt).
# Key Claude để ở backend/lambda-analyze/.env (máy mình) hoặc biến môi trường Lambda (AWS), KHÔNG BAO GIỜ ở đây.

# 1 = đọc lib/mock/*, không cần API · 0 = gọi API thật
NEXT_PUBLIC_USE_MOCK=1
# http://localhost:8787 (API chạy trên máy) hoặc https://<api-id>.execute-api.<region>.amazonaws.com (không có / cuối)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
